        "required": true,
        "description": "对应主分类下的细分类型"
      },
      {
        "name": "text",
        "label": "文案内容",
        "type": "textarea",
        "required": true,
        "description": "实际显示的文本内容"
      },
      {
        "name": "tags",
        "label": "标签",
        "type": "array",
        "required": false,
        "description": "用于搜索的关键词标签"
      },
      {
        "name": "priority",
        "label": "优先级",
        "type": "number",
        "required": false,
        "default": 0,
        "description": "数值越大，推荐排序越靠前"
      },
      {
        "name": "enabled",
        "label": "启用状态",
        "type": "boolean",
        "required": false,
        "default": true,
        "description": "是否在前端显示"
      },
      {
        "name": "createdAt",
        "label": "创建时间",
        "type": "string",
        "required": false,
        "description": "ISO 8601 格式时间"
      }
    ]
  },
